{
  "name": "codynex-os-backend",
  "version": "1.0.0",
  "description": "CodyNex OS autonomous software company backend (Express 5 + TypeORM + PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "start": "node -r dotenv/config dist/index.js",
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/database-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/database-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/database-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/database-source.ts",
    "seed": "ts-node src/database/seeds/run-seed.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "brotli": "^1.3.3",
    "bullmq": "^6.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  }
}
