NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/codynex_os_dev
ENABLE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379
ENABLE_WORKERS=true
WORKER_POLL_INTERVAL_MS=5000
WORKER_TICK_SECRET=change-this-to-a-32-char-random-worker-secret

ACCESS_TOKEN_SECRET=dev-or-test-access-token-secret-must-be-at-least-32-chars
REFRESH_TOKEN_SECRET=dev-or-test-refresh-token-secret-must-be-at-least-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
SALT_ROUNDS=10
ENCRYPTION_KEY=dev-32-byte-encryption-key-change-in-prod

CORS_ORIGIN=http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:3000

# Initial CEO seed (override in production)
CEO_EMAIL=ceo@codynex.local
CEO_PASSWORD=ChangeMeCEO!2026
CEO_NAME=Founder & CEO

# Free-tier AI Providers (Optional - app boots cleanly without any AI keys)
ALLOW_PAID_PROVIDERS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_MS=120000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Integrations
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CodyNex OS <noreply@codynex.local>
